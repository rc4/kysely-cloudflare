{
  "name": "kysely-cloudflare",
  "type": "module",
  "version": "0.2.0",
  "description": "Kysely dialects for Cloudflare D1 and SQLite-backed Durable Objects",
  "keywords": [
    "kysely",
    "kysely-dialect",
    "cloudflare",
    "cloudflare-workers",
    "d1",
    "durable-objects",
    "sqlite"
  ],
  "author": "rc4 <dh@rc4.io>",
  "license": "Artistic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rc4/kysely-cloudflare.git"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tests/tsconfig.json --noEmit",
    "release": "bumpp --pr",
    "prepublishOnly": "pnpm run build",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "lint": "oxlint",
    "test:workers": "vitest run --project workers",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "bumpp": "^12.3.0",
    "kysely": "^0.29.7",
    "miniflare": "5.20260930.0-alpha",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "kysely": "^0.29.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0"
}
